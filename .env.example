NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_API_URL=https://api.moazez.sa/api/v1
NEXT_PUBLIC_REALTIME_URL=https://api.moazez.sa/api/v1/realtime

# Leave empty first to use default Socket.IO path: /socket.io
# If backend mounts Socket.IO under API path, set:
# NEXT_PUBLIC_REALTIME_SOCKET_PATH=/api/v1/realtime/socket.io
NEXT_PUBLIC_REALTIME_SOCKET_PATH=

NEXT_PUBLIC_REALTIME_DEBUG=true
